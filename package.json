{
  "name": "malt",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Division4Studios/malt.git"
  },
  "homepage": "https://github.com/Division4Studios/malt/wiki",
  "bugs": "https://github.com/Division4Studios/malt/issues",
  "funding": "https://github.com/sponsors/Division4Studios",
  "description": "Local, durable coordination for independent coding agents (pure TypeScript on Node.js 24)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "bin": {
    "malt": "./src/cli.ts",
    "agentmesh": "./src/cli.ts"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p web/sw/tsconfig.json",
    "build:web": "tsc -p web/tsconfig.json && tsc -p web/sw/tsconfig.json && node scripts/build-shell.ts",
    "lint": "eslint --flag unstable_native_nodejs_ts_config --max-warnings 0 .",
    "lint:fix": "eslint --flag unstable_native_nodejs_ts_config --max-warnings 0 --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-concurrency=2 \"test/**/*.test.ts\"",
    "test:docker": "node scripts/smoke-docker.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build:web && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@typescript-eslint/parser": "8.71.2",
    "@typescript-eslint/utils": "8.71.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "65.3.1",
    "eslint-plugin-n": "18.4.1",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-security": "4.2.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "77.0.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "type-fest": "5.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
