{
  "name": "agentmesh",
  "version": "0.1.0",
  "description": "Local, durable coordination for independent coding agents (pure TypeScript on Node.js 24)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "bin": {
    "agentmesh": "./src/cli.ts"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --flag unstable_native_nodejs_ts_config --max-warnings 0 .",
    "lint:fix": "eslint --flag unstable_native_nodejs_ts_config --max-warnings 0 --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:docker": "node scripts/smoke-docker.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "65.1.0",
    "eslint-plugin-n": "18.4.1",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-security": "4.2.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "77.0.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "type-fest": "5.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
