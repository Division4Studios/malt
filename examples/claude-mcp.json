{
  "mcpServers": {
    "agentmesh": {
      "type": "stdio",
      "command": "docker",
      "timeout": 3600000,
      "args": [
        "compose",
        "-f",
        "/absolute/path/to/malt/compose.yaml",
        "exec",
        "-T",
        "broker",
        "node",
        "src/cli.ts",
        "mcp",
        "--project",
        "/data",
        "--provider",
        "anthropic",
        "--runtime",
        "claude-code"
      ]
    }
  }
}
