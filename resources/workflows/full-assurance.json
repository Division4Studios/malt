{
  "version": 1,
  "id": "full-assurance",
  "name": "Full assurance",
  "description": "For work that needs a settled specification. An independent reviewer from a different model family checks the plan before a fresh revision. Each delivery gets two cross-family reviews (one blind), a fixer who rules on every finding with evidence, a documentation pass, and an independent regression check of the adopted fixes before the final check, merge and main verification.",
  "planning": [
    { "id": "specify", "kind": "specify", "title": "Specification", "roles": ["product-owner"] },
    { "id": "plan", "kind": "plan", "title": "Atomic delivery plan", "roles": ["team-lead"], "after": ["specify"] },
    {
      "id": "plan-review",
      "kind": "plan_review",
      "title": "Independent plan review",
      "roles": ["plan-reviewer"],
      "after": ["plan"],
      "provider": "codex"
    },
    {
      "id": "plan-revise",
      "kind": "plan_revise",
      "title": "Plan revision",
      "roles": ["team-lead"],
      "after": ["plan-review"]
    }
  ],
  "delivery": [
    { "id": "implement", "kind": "implement", "title": "Implementation", "roles": ["developer-1", "developer-2"] },
    {
      "id": "review",
      "kind": "review",
      "title": "Code review",
      "roles": ["qa-1"],
      "after": ["implement"],
      "provider": "codex"
    },
    {
      "id": "blind-review",
      "kind": "review",
      "title": "Blind code review",
      "roles": ["qa-2"],
      "after": ["implement"],
      "blind": true,
      "provider": "claude"
    },
    {
      "id": "fix",
      "kind": "adjudicate",
      "title": "Rule on findings and fix",
      "roles": ["fixer"],
      "after": ["review", "blind-review"]
    },
    {
      "id": "document",
      "kind": "document",
      "title": "Documentation",
      "roles": ["librarian"],
      "after": ["fix"],
      "optional": true
    },
    {
      "id": "regress",
      "kind": "regress",
      "title": "Regression verification",
      "roles": ["regression-verifier"],
      "after": ["document"]
    },
    {
      "id": "final",
      "kind": "final",
      "title": "Final end-to-end check",
      "roles": ["final-tester"],
      "after": ["regress"]
    },
    { "id": "verify", "kind": "verify", "title": "Verify merged main", "roles": ["final-tester"], "after": ["final"] }
  ]
}
